{
  "name": "@shiftlabs/codemode-websearch",
  "version": "0.1.0",
  "description": "Search the web from codemode through one action, whichever search provider you have a key for",
  "type": "module",
  "keywords": [
    "codemode-plugin",
    "web-search",
    "search",
    "brave",
    "exa",
    "tavily",
    "parallel",
    "perplexity"
  ],
  "codemode": {
    "plugins": [
      "./src/index.ts"
    ]
